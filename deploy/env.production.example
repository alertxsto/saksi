# Template for /home/ubuntu/saksi/web/.env.production (chmod 600). Fill in on the VM only.
# Read by systemd (EnvironmentFile) and by `next build`: plain KEY=value lines, no `export`,
# no quotes around values, no spaces around '='.
#
# NEXT_PUBLIC_* values are baked into the browser bundle at build time. After changing
# them, run deploy/deploy.sh again (it notices and rebuilds). Never put secrets in them.

# Public site URL (canonical links / metadata).
NEXT_PUBLIC_SITE_URL=

# Browser-visible Sepolia RPC URLs (public endpoints, no secret API key).
# deploy/caddy-install.sh adds their origins to the CSP connect-src.
NEXT_PUBLIC_RPC_PRIMARY=
NEXT_PUBLIC_RPC_SECONDARY=
NEXT_PUBLIC_RPC_TERTIARY=

# Deployed contract addresses and the deployment block (Sepolia).
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_JOURNAL_ADDRESS=
NEXT_PUBLIC_BREACH_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=

# Server only.
# Neon connection string (the app uses the Neon HTTP driver, so it must be a Neon URL).
DATABASE_URL=
# 32 random bytes as 64 hex characters each: openssl rand -hex 32
SUBJECT_KEY=
DATA_KEY=
# At least 32 bytes: openssl rand -hex 32
SESSION_SECRET=
# Header value for /api/status and /api/demo/tamper; deploy.sh and preflight.sh read it too.
DEMO_ADMIN_TOKEN=

# OpenAI-compatible endpoint used for explanations and breach-notice drafts.
# AI_PROVIDER is the label shown in the UI (defaults to the AI_BASE_URL host name).
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=

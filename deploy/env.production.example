# Template for /home/ubuntu/saksi/web/.env.production (chmod 600). Fill in on the VM only.
# Read by docker compose (env_file in deploy/compose.yaml) when the container starts, and by
# deploy/deploy.sh, which passes the NEXT_PUBLIC_* values to `docker build` as build args.
# Plain KEY=value lines, no `export`, no spaces around '='. Compose expands $VAR inside values,
# so wrap any value that contains a '$' in single quotes: KEY='va$lue'.
#
# NEXT_PUBLIC_* values are baked into the image (browser and server bundles) at build time.
# After changing them, run deploy/deploy.sh again (it notices and rebuilds). Never put secrets
# in them. Server-only values only need a restart: cd ~/saksi/deploy && docker compose up -d --force-recreate web

# Public site URL. Not read by the code yet and not a build arg, so it has no effect today.
NEXT_PUBLIC_SITE_URL=

# Browser-visible Sepolia RPC URLs (public endpoints, no secret API key).
# deploy/caddy-install.sh adds their origins to the CSP connect-src.
NEXT_PUBLIC_RPC_PRIMARY=
NEXT_PUBLIC_RPC_SECONDARY=
NEXT_PUBLIC_RPC_TERTIARY=

# Deployed contract addresses and the deployment block (Sepolia).
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_JOURNAL_ADDRESS=
NEXT_PUBLIC_BREACH_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=

# Server only.
# Neon connection string (the app uses the Neon HTTP driver, so it must be a Neon URL).
# Postgres container from deploy/compose.yaml (or a hosted Postgres URL with sslmode=require).
POSTGRES_PASSWORD=
DATABASE_URL=postgres://saksi:<POSTGRES_PASSWORD>@db:5432/saksi
# 32 random bytes as 64 hex characters each: openssl rand -hex 32
SUBJECT_KEY=
DATA_KEY=
# At least 32 bytes: openssl rand -hex 32
SESSION_SECRET=
# Header value for /api/status and /api/demo/tamper; deploy.sh and preflight.sh read it too.
DEMO_ADMIN_TOKEN=
# Optional: true or false. Empty = Secure cookies when the browser used https (Caddy sends
# x-forwarded-proto), which is right behind Caddy.
COOKIE_SECURE=

# OpenAI-compatible endpoint used for explanations and breach-notice drafts.
# AI_PROVIDER is the label shown in the UI (defaults to the AI_BASE_URL host name).
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=

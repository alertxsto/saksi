# systemd --user unit for the Saksi Next.js server.
# Installed by deploy/deploy.sh to ~/.config/systemd/user/saksi-web.service.
# Needs lingering so it runs without an SSH session: sudo loginctl enable-linger ubuntu
[Unit]
Description=Saksi web (Next.js) on 127.0.0.1:3400
Documentation=https://github.com/alertxsto/saksi/blob/main/deploy/README.md
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/saksi/web
# NODE_ENV and friends first; EnvironmentFile values win if they repeat a key.
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# Keep the V8 heap below MemoryMax so Node collects garbage before the cgroup OOM-kills it.
Environment=NODE_OPTIONS=--max-old-space-size=768
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/ubuntu/saksi/web/.env.production
ExecStart=/home/ubuntu/.local/bin/node /home/ubuntu/saksi/web/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3400
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
MemoryMax=1G
Nice=5
NoNewPrivileges=yes
UMask=0077
SyslogIdentifier=saksi-web

[Install]
WantedBy=default.target

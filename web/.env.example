# Local development: copy to web/.env.local. Production (Docker): deploy/env.production.example.
# Required values are checked by lib/server/config.ts; /api/status reports which ones are missing.

# --- Browser-visible (NEXT_PUBLIC_*): inlined into the bundle at build time. Never put secrets here. ---

# Required. Public Sepolia RPC URLs (no secret API key). Secondary/tertiary are optional fallbacks.
NEXT_PUBLIC_RPC_PRIMARY=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_SECONDARY=
NEXT_PUBLIC_RPC_TERTIARY=

# Required. Deployed contracts and deployment block (contracts/deployments/sepolia.json).
NEXT_PUBLIC_REGISTRY_ADDRESS=0x3d9dE4717a7398d24239b8370b23DCAd7a07f737
NEXT_PUBLIC_JOURNAL_ADDRESS=0xAb9b73586610697deb7Ae59A59e991f5177CB263
NEXT_PUBLIC_BREACH_ADDRESS=0x71Ff16F068A845F3D3dfd63584a31A9de86fE462
NEXT_PUBLIC_DEPLOY_BLOCK=12181663

# Optional. Site URL for proof links, QR codes and metadata (default http://localhost:3401).
NEXT_PUBLIC_SITE_URL=
# Optional. Overrides for the chain label (default Sepolia), block explorer
# (default https://sepolia.etherscan.io) and the faucet shown when a wallet has no gas.
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_FAUCET_URL=
# Optional. Set to 1 to show the /dev galleries in a production build.
NEXT_PUBLIC_SHOW_DEV=

# --- Server only ---

# Required. postgres:// or postgresql:// URL (add ?sslmode=require for a hosted database).
DATABASE_URL=
# Required. 32 random bytes as 64 hex characters each: openssl rand -hex 32
SUBJECT_KEY=
DATA_KEY=
# Required. At least 32 bytes: openssl rand -hex 32
SESSION_SECRET=
# Optional. x-demo-token header value for /api/status and /api/demo/tamper. Empty = both answer 403.
DEMO_ADMIN_TOKEN=
# Optional: true or false. Empty = Secure cookie only when the browser uses https (x-forwarded-proto).
COOKIE_SECURE=

# Optional. OpenAI-compatible endpoint for receipt explanations and breach-notice drafts.
# Without it the app answers with fixed templates. AI_PROVIDER is the UI label (default: AI_BASE_URL host).
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_MODEL=
# Comma-separated models for pnpm ai:eval (offline drafter evaluation).
AI_EVAL_MODELS=
